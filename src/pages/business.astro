---
const title = "Business Services | NateNate";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta
      name="description"
      content="Digital services, web design, data tools, transcribing, dashboards, portfolio projects, and computer services by NateNate."
    />
  </head>

  <body>
    <main class="business-shell">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <p>NateNate</p>
          <h1>Business Hub</h1>
        </div>

        <nav class="sidebar-nav">
          <a href="/blog-cover">Blog Side</a>
          <a href="/shop">Shop</a>
          <a href="/login">Sign Up / Login</a>
          <a href="/admin/dashboard" class="admin-button">Admin</a>
        </nav>

        <div class="sidebar-footer">
          <span class="status-dot"></span>
          <span>Hub Online</span>
        </div>
      </aside>

      <section class="main-panel">
        <section class="hero">
          <div class="hero-grid">
            <div>
              <p class="tag">Computer Programming & Data Analysis</p>
              <h2>NateNate Digital Services</h2>
            </div>

            <div class="hero-actions">
              <a href="#services">View Services</a>
              <a href="#portfolio">View Portfolio</a>
              <a href="#contact">Contact</a>
            </div>
          </div>
        </section>

        <section id="services" class="content-section">
          <div class="section-bar">
            <h2>Services</h2>
            <span id="serviceCount">Loading</span>
          </div>

          <div id="servicesGrid" class="services-grid">
            <p class="loading-text">Loading services...</p>
          </div>
        </section>

        <section id="portfolio" class="content-section">
          <div class="section-bar">
            <h2>Portfolio</h2>
            <span id="projectCount">Loading</span>
          </div>

          <div id="projectsGrid" class="projects-grid">
            <p class="loading-text">Loading portfolio...</p>
          </div>
        </section>

        <section id="contact" class="contact-section">
          <div class="section-bar">
            <h2>Contact</h2>
            <span>Connect</span>
          </div>

          <div class="contact-grid">
            <a id="emailLink" href="#" class="contact-card">
              Email loading...
            </a>

            <a id="phoneLink" href="#" class="contact-card">
              Phone loading...
            </a>

            <a href="/request-service" class="contact-card">
              Request Service
            </a>
          </div>
        </section>
      </section>
    </main>

    <script type="module">
      import { supabase } from "../lib/supabase.js";

      const servicesGrid = document.querySelector("#servicesGrid");
      const projectsGrid = document.querySelector("#projectsGrid");
      const serviceCount = document.querySelector("#serviceCount");
      const projectCount = document.querySelector("#projectCount");
      const emailLink = document.querySelector("#emailLink");
      const phoneLink = document.querySelector("#phoneLink");

      function escapeHTML(value) {
        if (!value) return "";

        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function cleanPhoneForLink(phone) {
        if (!phone) return "";
        return phone.replace(/[^\d+]/g, "");
      }

      async function loadContact() {
        const { data, error } = await supabase
          .from("site_contact")
          .select("*")
          .limit(1)
          .maybeSingle();

        if (error || !data) {
          console.error(error);
          emailLink.textContent = "Email unavailable";
          phoneLink.textContent = "Phone unavailable";
          return;
        }

        const email = data.business_email || "";
        const phone = data.business_phone || "";

        emailLink.textContent = email ? `Email: ${email}` : "Email unavailable";
        emailLink.href = email ? `mailto:${email}` : "#";

        phoneLink.textContent = phone ? `Call: ${phone}` : "Phone unavailable";
        phoneLink.href = phone ? `tel:${cleanPhoneForLink(phone)}` : "#";
      }

      async function loadServices() {
        const { data, error } = await supabase
          .from("services")
          .select("*")
          .eq("is_active", true)
          .order("id", { ascending: true });

        if (error) {
          console.error(error);
          serviceCount.textContent = "Error";
          servicesGrid.innerHTML =
            '<p class="loading-text">Services could not load.</p>';
          return;
        }

        if (!data || data.length === 0) {
          serviceCount.textContent = "0";
          servicesGrid.innerHTML =
            '<p class="loading-text">No services have been added yet.</p>';
          return;
        }

        serviceCount.textContent = `${data.length} Active`;

        servicesGrid.innerHTML = data
          .map((service) => {
            const title = escapeHTML(service.title);
            const code = escapeHTML(service.service_code);
            const description = escapeHTML(
              service.short_description || service.description || ""
            );
            const estimate = escapeHTML(service.estimate_text || "");
            const image = escapeHTML(
              service.image_url || "/images/default-service.jpg"
            );

            return `
              <article class="service-card">
                <a href="/request-service?service=${encodeURIComponent(
                  service.service_code
                )}">
                  <div class="card-image">
                    <img src="${image}" alt="${title}" />
                  </div>

                  <div class="card-body">
                    <div class="card-topline">
                      <span>${code}</span>
                    </div>

                    <h3>${title}</h3>

                    ${description ? `<p>${description}</p>` : ""}

                    ${
                      estimate
                        ? `<div class="estimate-chip">${estimate}</div>`
                        : ""
                    }

                    <div class="card-action">Request Service →</div>
                  </div>
                </a>
              </article>
            `;
          })
          .join("");
      }

      async function loadProjects() {
        const { data, error } = await supabase
          .from("projects")
          .select("*")
          .order("id", { ascending: false });

        if (error) {
          console.error(error);
          projectCount.textContent = "Error";
          projectsGrid.innerHTML =
            '<p class="loading-text">Portfolio could not load.</p>';
          return;
        }

        if (!data || data.length === 0) {
          projectCount.textContent = "0";
          projectsGrid.innerHTML =
            '<p class="loading-text">No portfolio projects have been added yet.</p>';
          return;
        }

        projectCount.textContent = `${data.length} Projects`;

        projectsGrid.innerHTML = data
          .map((project) => {
            const title = escapeHTML(project.title);
            const code = escapeHTML(project.service_code || "PROJECT");
            const category = escapeHTML(project.category || "");
            const description = escapeHTML(project.description || "");
            const image = escapeHTML(
              project.image_url || "/images/default-project.jpg"
            );
            const projectUrl = escapeHTML(project.project_url || "");

            return `
              <article class="project-card">
                <div class="project-image">
                  <img src="${image}" alt="${title}" />
                </div>

                <div class="project-body">
                  <div class="card-topline">
                    <span>${code}</span>
                    ${category ? `<span>${category}</span>` : ""}
                  </div>

                  <h3>${title}</h3>

                  ${description ? `<p>${description}</p>` : ""}

                  ${
                    projectUrl
                      ? `<a href="${projectUrl}" target="_blank" rel="noopener">View Project →</a>`
                      : ""
                  }
                </div>
              </article>
            `;
          })
          .join("");
      }

      loadContact();
      loadServices();
      loadProjects();
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top right, rgba(43, 199, 178, 0.08), transparent 34rem),
      radial-gradient(circle at bottom left, rgba(120, 131, 150, 0.08), transparent 30rem),
      #f4f6f8;
    color: #101418;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  .business-shell {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 1.2rem;
    background:
      linear-gradient(180deg, #111827, #0b111c),
      #111827;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 14px 0 40px rgba(16, 20, 24, 0.16);
  }

  .sidebar-brand {
    padding: 1rem;
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sidebar-brand p {
    margin: 0 0 0.5rem;
    color: #7dd3c7;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .sidebar-brand h1 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .sidebar-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .sidebar-nav a {
    position: relative;
    display: block;
    padding: 1rem;
    overflow: hidden;
    border-radius: 0.95rem;
    color: #e5e7eb;
    font-weight: 850;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .sidebar-nav a::before {
    content: "";
    position: absolute;
    inset: 0;
    width: 4px;
    background: #7dd3c7;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .sidebar-nav a:hover {
    transform: translateX(5px);
    background: rgba(125, 211, 199, 0.1);
    border-color: rgba(125, 211, 199, 0.38);
  }

  .sidebar-nav a:hover::before {
    opacity: 1;
  }

  .sidebar-nav .admin-button {
    margin-top: 1rem;
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .sidebar-nav .admin-button:hover {
    background: rgba(125, 211, 199, 0.12);
    border-color: rgba(125, 211, 199, 0.38);
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding: 1rem;
    color: #aab2bf;
    font-size: 0.82rem;
    font-weight: 800;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .status-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #7dd3c7;
    box-shadow: 0 0 14px rgba(125, 211, 199, 0.65);
  }

  .main-panel {
    min-width: 0;
    padding: 1.5rem;
  }

  .hero,
  .content-section,
  .contact-section {
    position: relative;
    overflow: hidden;
    border-radius: 1.4rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(248, 250, 252, 0.94)),
      #ffffff;
    border: 1px solid rgba(16, 20, 24, 0.08);
    box-shadow: 0 18px 45px rgba(16, 20, 24, 0.08);
  }

  .hero::before,
  .content-section::before,
  .contact-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(16, 20, 24, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 20, 24, 0.035) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .hero {
    min-height: 360px;
    display: flex;
    align-items: center;
    padding: 3rem;
    background:
      linear-gradient(135deg, rgba(17, 24, 39, 0.96), rgba(31, 41, 55, 0.92)),
      #111827;
    color: #f8fafc;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    width: 100%;
    align-items: end;
  }

  .tag {
    margin: 0 0 1rem;
    color: #7dd3c7;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero h2 {
    margin: 0;
    max-width: 820px;
    color: #f8fafc;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-actions a,
  .contact-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.1rem;
    border-radius: 999px;
    color: #111827;
    font-weight: 900;
    text-decoration: none;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.42);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-actions a:hover,
  .contact-card:hover {
    transform: translateY(-2px);
    background: #7dd3c7;
    border-color: #7dd3c7;
  }

  .content-section,
  .contact-section {
    margin-top: 1.5rem;
    padding: 2rem;
  }

  .section-bar {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(16, 20, 24, 0.09);
  }

  .section-bar h2 {
    margin: 0;
    color: #101418;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .section-bar span {
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    color: #0f766e;
    font-size: 0.8rem;
    font-weight: 900;
    background: rgba(125, 211, 199, 0.13);
    border: 1px solid rgba(15, 118, 110, 0.14);
  }

  .services-grid,
  .projects-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-card,
  .project-card {
    overflow: hidden;
    border-radius: 1.15rem;
    background: #ffffff;
    border: 1px solid rgba(16, 20, 24, 0.08);
    box-shadow: 0 14px 35px rgba(16, 20, 24, 0.07);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover,
  .project-card:hover {
    transform: translateY(-5px);
    border-color: rgba(15, 118, 110, 0.3);
    box-shadow: 0 22px 48px rgba(16, 20, 24, 0.12);
  }

  .service-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-image,
  .project-image {
    height: 185px;
    background:
      linear-gradient(135deg, rgba(17, 24, 39, 0.9), rgba(55, 65, 81, 0.86)),
      #111827;
  }

  .card-image img,
  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body,
  .project-body {
    padding: 1.2rem;
  }

  .card-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.8rem;
  }

  .card-topline span {
    display: inline-flex;
    padding: 0.38rem 0.6rem;
    border-radius: 999px;
    color: #0f766e;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    background: rgba(125, 211, 199, 0.13);
    border: 1px solid rgba(15, 118, 110, 0.13);
  }

  .service-card h3,
  .project-card h3 {
    margin: 0 0 0.7rem;
    color: #101418;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .service-card p,
  .project-card p {
    margin: 0;
    color: #5f6b7a;
    line-height: 1.6;
  }

  .estimate-chip {
    margin-top: 1rem;
    padding: 0.8rem;
    border-radius: 0.9rem;
    color: #101418;
    font-weight: 800;
    line-height: 1.5;
    background: #f3f7f7;
    border: 1px solid rgba(16, 20, 24, 0.08);
  }

  .card-action,
  .project-card a {
    display: inline-flex;
    margin-top: 1rem;
    color: #0f766e;
    font-weight: 900;
    text-decoration: none;
  }

  .contact-section {
    margin-bottom: 1.5rem;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-card {
    border-radius: 1.1rem;
    color: #101418;
    background: #ffffff;
    border: 1px solid rgba(16, 20, 24, 0.08);
    box-shadow: 0 14px 35px rgba(16, 20, 24, 0.06);
  }

  .contact-card:hover {
    color: #101418;
    background: #e6fffb;
    border-color: rgba(15, 118, 110, 0.22);
  }

  .loading-text {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    color: #5f6b7a;
    font-weight: 800;
  }

  @media (max-width: 1150px) {
    .business-shell {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
    }

    .hero-grid,
    .services-grid,
    .projects-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .business-shell {
      grid-template-columns: 86px minmax(0, 1fr);
    }

    .sidebar {
      padding: 0.7rem;
    }

    .sidebar-brand {
      padding: 0.7rem;
    }

    .sidebar-brand p {
      font-size: 0.58rem;
      letter-spacing: 0.12em;
    }

    .sidebar-brand h1 {
      font-size: 0.8rem;
      line-height: 1.1;
    }

    .sidebar-nav {
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .sidebar-nav a {
      padding: 0.7rem 0.45rem;
      border-radius: 0.75rem;
      font-size: 0.68rem;
      text-align: center;
    }

    .sidebar-footer {
      display: none;
    }

    .main-panel {
      padding: 0.75rem;
    }

    .hero,
    .content-section,
    .contact-section {
      padding: 1.1rem;
      border-radius: 1rem;
    }

    .hero {
      min-height: 280px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero h2 {
      font-size: clamp(2.1rem, 12vw, 4rem);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .section-bar {
      align-items: flex-start;
      flex-direction: column;
    }

    .card-image,
    .project-image {
      height: 145px;
    }
  }
</style>
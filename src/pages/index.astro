---
const title = "Welcome | NateNate";
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden; 
            font-family: 'Georgia', serif;
            background-color: #000;
        }

        .entrance-container {
            display: flex;
            width: 100vw;
            height: 100vh;
        }

        .side {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-decoration: none;
            transition: flex 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 1;
        }

        .side:hover {
            flex: 1.4; /* Makes the side you hover over grow wider */
            z-index: 2;
        }

        /* BUSINESS SIDE (Now on the Left) */
        .business-side {
            background-color: #f4f4f4; 
            color: #1a1a1a;
            border-right: 1px solid #ddd;
        }

        /* BLOG SIDE (Now on the Right) */
        .blog-side {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.5)), url('/galaxy-bg.jpg') no-repeat center center;
            background-size: cover;
            color: #fff;
        }

        /* TEXT STYLING */
        .side h1 {
            font-size: 3.5rem;
            margin: 0;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .side p {
            font-style: italic;
            margin-top: 15px;
            font-size: 1.2rem;
            opacity: 0.8;
        }

        .enter-btn {
            margin-top: 40px;
            padding: 15px 40px;
            border: 1px solid;
            background: transparent;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 2px;
            transition: all 0.3s ease;
        }

        .business-side .enter-btn { border-color: #000; color: #000; }
        .business-side .enter-btn:hover { background: #000; color: #fff; }

        .blog-side .enter-btn { border-color: #fff; color: #fff; }
        .blog-side .enter-btn:hover { background: #fff; color: #000; }
    </style>
</head>
<body>

    <div class="entrance-container">
        <a href="/one-percent-club" class="side business-side">
            <h1>Business</h1>
            <p>Professional Services & Solutions</p>
            <button class="enter-btn">Work With Me</button>
        </a>

        <a href="/blog-cover" class="side blog-side">
            <h1>The Blog</h1>
            <p>Look Up With Me</p>
            <button class="enter-btn">Read Stories</button>
        </a>
    </div>

</body>
</html>
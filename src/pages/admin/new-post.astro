---
// src/pages/admin/new-post.astro
import { supabase } from "../../lib/supabase.js";

const title = "Admin Portal | NateNate";

function attr(value: unknown) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

// Blog posts
const { data: allPosts, error: fetchError } = await supabase
  .from("posts")
  .select("*")
  .order("created_at", { ascending: false });

if (fetchError) {
  console.error("Error loading dashboard posts:", fetchError.message);
}

const postsList = allPosts || [];

// Business contact
const { data: contactData, error: contactError } = await supabase
  .from("site_contact")
  .select("*")
  .order("id", { ascending: true })
  .limit(1)
  .maybeSingle();

if (contactError) {
  console.error("Error loading business contact:", contactError.message);
}

const contactInfo = contactData || null;

// Services
const { data: allServices, error: servicesError } = await supabase
  .from("services")
  .select("*")
  .order("id", { ascending: true });

if (servicesError) {
  console.error("Error loading services:", servicesError.message);
}

const servicesList = allServices || [];

// Projects
const { data: allProjects, error: projectsError } = await supabase
  .from("projects")
  .select("*")
  .order("id", { ascending: false });

if (projectsError) {
  console.error("Error loading projects:", projectsError.message);
}

const projectsList = allProjects || [];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <style>
      :root {
        --bg: #f8f7f3;
        --paper: #ffffff;
        --text: #1d2430;
        --muted: #687385;
        --line: #d9dee7;
        --accent: #263b59;
        --accent-dark: #16243a;
        --accent-soft: #e7ecf3;
        --danger: #a63a3a;
        --success: #2e5630;
        --teal: #0f766e;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at top right, rgba(15, 118, 110, 0.08), transparent 34rem),
          radial-gradient(circle at bottom left, rgba(38, 59, 89, 0.08), transparent 30rem),
          var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        padding: 40px 20px;
      }

      .dashboard-container {
        max-width: 1180px;
        margin: 0 auto;
        background: var(--paper);
        padding: 32px;
        border-radius: 18px;
        border: 1px solid var(--line);
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
      }

      .top-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 20px;
      }

      .back-links,
      .quick-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .back-links a,
      .quick-nav a {
        text-decoration: none;
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 800;
        padding: 9px 12px;
        border-radius: 999px;
        background: var(--bg);
        border: 1px solid var(--line);
      }

      .back-links a:hover,
      .quick-nav a:hover {
        color: var(--accent);
        background: var(--accent-soft);
      }

      h1,
      h2,
      h3 {
        font-family: Georgia, serif;
        margin-top: 0;
      }

      h1 {
        margin-bottom: 6px;
        font-size: clamp(2rem, 5vw, 3.8rem);
        line-height: 0.95;
        letter-spacing: -0.055em;
      }

      .intro {
        color: var(--muted);
        margin: 0 0 22px;
        line-height: 1.6;
        font-weight: 650;
      }

      .quick-nav {
        padding: 14px;
        margin: 22px 0 32px;
        border-radius: 14px;
        background: var(--bg);
        border: 1px solid var(--line);
      }

      .admin-section {
        padding: 24px;
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid var(--line);
        margin-top: 24px;
      }

      .admin-section:nth-of-type(even) {
        background: #fcfcfb;
      }

      .section-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }

      .section-heading h2 {
        margin: 0;
      }

      .section-heading p {
        margin: 4px 0 0;
        color: var(--muted);
        font-weight: 650;
        line-height: 1.5;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        border-radius: 999px;
        color: var(--teal);
        background: rgba(15, 118, 110, 0.1);
        border: 1px solid rgba(15, 118, 110, 0.16);
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .form-grid {
        display: grid;
        gap: 16px;
        background: var(--bg);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--line);
        margin-bottom: 28px;
      }

      .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-weight: bold;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: var(--accent);
      }

      input,
      textarea,
      select {
        padding: 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        font-size: 1rem;
        font-family: inherit;
        background: var(--paper);
        color: var(--text);
      }

      textarea {
        resize: vertical;
        min-height: 120px;
      }

      .small-note {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 650;
        text-transform: none;
        line-height: 1.4;
      }

      .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      button {
        padding: 12px 22px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s, box-shadow 0.2s;
      }

      button:hover {
        opacity: 0.92;
      }

      button:active {
        transform: scale(0.98);
      }

      .btn-primary {
        background: var(--accent);
        color: white;
      }

      .btn-secondary {
        background: var(--line);
        color: var(--text);
      }

      .btn-edit {
        background: #dfc443;
        color: #332d11;
        padding: 7px 11px;
        font-size: 0.8rem;
        border-radius: 6px;
      }

      .btn-delete {
        background: var(--danger);
        color: white;
        padding: 7px 11px;
        font-size: 0.8rem;
        border-radius: 6px;
      }

      .btn-toggle {
        background: var(--teal);
        color: white;
        padding: 7px 11px;
        font-size: 0.8rem;
        border-radius: 6px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 14px;
        font-size: 0.95rem;
      }

      th,
      td {
        padding: 14px;
        text-align: left;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }

      th {
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: bold;
      }

      .actions-cell {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      code {
        background: var(--accent-soft);
        padding: 2px 6px;
        border-radius: 4px;
      }

      .status-message {
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: none;
        font-weight: bold;
        text-align: center;
      }

      .status-message.success {
        display: block;
        background: var(--success);
        color: white;
      }

      .status-message.error {
        display: block;
        background: var(--danger);
        color: white;
      }

      .mini-preview {
        max-width: 320px;
        color: var(--muted);
        line-height: 1.45;
      }

      .image-note {
        max-width: 260px;
        overflow-wrap: anywhere;
        color: var(--muted);
        font-size: 0.85rem;
      }

      @media (max-width: 850px) {
        body {
          padding: 18px 10px;
        }

        .dashboard-container {
          padding: 18px;
        }

        .admin-section {
          padding: 16px;
        }

        .two-col {
          grid-template-columns: 1fr;
        }

        table,
        thead,
        tbody,
        th,
        td,
        tr {
          display: block;
        }

        thead {
          display: none;
        }

        tr {
          padding: 12px 0;
          border-bottom: 1px solid var(--line);
        }

        td {
          border-bottom: 0;
          padding: 7px 0;
        }

        td::before {
          content: attr(data-label);
          display: block;
          color: var(--accent);
          font-size: 0.72rem;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.08em;
          margin-bottom: 3px;
        }
      }
    </style>
  </head>

  <body>
    <div class="dashboard-container">
      <div class="top-row">
        <div class="back-links">
          <a href="/content">← Blog Public View</a>
          <a href="/business">← Business Public View</a>
        </div>
      </div>

      <h1>Website Admin Dashboard</h1>
      <p class="intro">
        This one page controls both sides of your site: blog posts and the business page.
      </p>

      <div class="quick-nav">
        <a href="#blog-posts">Blog Posts</a>
        <a href="#business-contact">Business Contact</a>
        <a href="#business-services">Services</a>
        <a href="#business-projects">Portfolio Projects</a>
      </div>

      <div id="status-message" class="status-message"></div>

      <section id="blog-posts" class="admin-section">
        <div class="section-heading">
          <div>
            <h2 id="form-action-title">Create New Post</h2>
            <p>Add, edit, or delete posts for the blog/content side.</p>
          </div>
          <span class="pill">{postsList.length} posts</span>
        </div>

        <form id="postCrudForm" class="form-grid">
          <input type="hidden" id="post-id" value="" />

          <div class="two-col">
            <label>
              Section Location
              <select id="post-section" required>
                <option value="curious">Curiosity Notes</option>
                <option value="research">Research & Reports</option>
              </select>
            </label>

            <label>
              Publication Status
              <select id="post-published">
                <option value="true">Published (Live)</option>
                <option value="false">Draft (Hidden)</option>
              </select>
            </label>
          </div>

          <label>
            Article Title
            <input type="text" id="post-title" required placeholder="Ex. The Physics of Cloud Formations" />
          </label>

          <label>
            Feature Image URL
            <input type="url" id="post-image-url" placeholder="https://images.unsplash.com/example..." />
          </label>

          <label>
            Excerpt / Short Summary
            <input type="text" id="post-excerpt" required placeholder="A brief summary sentence..." />
          </label>

          <label>
            Full Content Material
            <textarea id="post-content" required placeholder="Write or paste your article markdown/text content here..."></textarea>
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary" id="submit-btn">Save Post Entry</button>
            <button type="button" class="btn-secondary" id="clear-form-btn" style="display: none;">Cancel Edit</button>
          </div>
        </form>

        <h3>Existing Blog Posts</h3>
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Section</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {postsList.length === 0 ? (
              <tr>
                <td colspan="4" style="text-align: center; color: var(--muted);">
                  No records found in database posts table.
                </td>
              </tr>
            ) : (
              postsList.map((post: any) => (
                <tr data-post-row-id={post.id}>
                  <td data-label="Title" style="font-weight: bold;">{post.title}</td>
                  <td data-label="Section"><code>{post.section}</code></td>
                  <td data-label="Status">{post.published ? "🟢 Live" : "⚪ Draft"}</td>
                  <td data-label="Actions" class="actions-cell">
                    <button
                      type="button"
                      class="btn-edit post-edit-btn"
                      data-id={attr(post.id)}
                      data-title={attr(post.title)}
                      data-section={attr(post.section)}
                      data-published={attr(String(post.published))}
                      data-image-url={attr(post.image_url || "")}
                      data-excerpt={attr(post.excerpt || post.preview || "")}
                      data-content={attr(post.content || "")}
                    >
                      Edit
                    </button>

                    <button type="button" class="btn-delete post-delete-btn" data-id={attr(post.id)}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>

      <section id="business-contact" class="admin-section">
        <div class="section-heading">
          <div>
            <h2>Business Contact Info</h2>
            <p>This updates the email and phone number shown on your business page.</p>
          </div>
          <span class="pill">site_contact</span>
        </div>

        <form id="contactForm" class="form-grid">
          <input type="hidden" id="contact-id" value={contactInfo?.id || ""} />

          <div class="two-col">
            <label>
              Business Email
              <input
                type="email"
                id="business-email"
                value={contactInfo?.business_email || ""}
                placeholder="yourname@email.com"
              />
            </label>

            <label>
              Business Phone
              <input
                type="text"
                id="business-phone"
                value={contactInfo?.business_phone || ""}
                placeholder="321-555-1234"
              />
            </label>
          </div>

          <div class="btn-group">
            <button type="submit" class="btn-primary">Save Contact Info</button>
          </div>
        </form>
      </section>

      <section id="business-services" class="admin-section">
        <div class="section-heading">
          <div>
            <h2 id="service-form-title">Add Business Service</h2>
            <p>Add, edit, turn off, or delete services from your business page.</p>
          </div>
          <span class="pill">{servicesList.length} services</span>
        </div>

        <form id="serviceForm" class="form-grid">
          <input type="hidden" id="service-id" value="" />

          <div class="two-col">
            <label>
              Service Title
              <input type="text" id="service-title" required placeholder="Websites & Landing Pages" />
            </label>

            <label>
              Service Code
              <input type="text" id="service-code" required placeholder="WEB-01" />
              <span class="small-note">
                This connects projects to services. Example: WEB-01, DATA-01, SHEET-01
              </span>
            </label>
          </div>

          <label>
            Service Image URL
            <input type="url" id="service-image-url" placeholder="https://..." />
          </label>

          <label>
            Estimate / Starting Price
            <input
              type="text"
              id="service-estimate-text"
              placeholder="Starting at $25"
            />
            <span class="small-note">
              This shows in the price section and price pop-up on your business page.
              Example: Starting at $25, Starting at $15/hr, or Starting at $35 • Parts not included
            </span>
          </label>

          <label>
            Service Description
            <textarea id="service-description" required placeholder="Describe what this service includes..."></textarea>
          </label>

          <label>
            Active Status
            <select id="service-active">
              <option value="true">Active: show on business page</option>
              <option value="false">Hidden: do not show on business page</option>
            </select>
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary" id="service-submit-btn">Save Service</button>
            <button type="button" class="btn-secondary" id="service-clear-btn" style="display: none;">Cancel Edit</button>
          </div>
        </form>

        <h3>Existing Services</h3>
        <table>
          <thead>
            <tr>
              <th>Service</th>
              <th>Code</th>
              <th>Status</th>
              <th>Price</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {servicesList.length === 0 ? (
              <tr>
                <td colspan="6" style="text-align: center; color: var(--muted);">
                  No services found.
                </td>
              </tr>
            ) : (
              servicesList.map((service: any) => (
                <tr data-service-row-id={service.id}>
                  <td data-label="Service" style="font-weight: bold;">{service.title}</td>
                  <td data-label="Code"><code>{service.service_code}</code></td>
                  <td data-label="Status">{service.is_active ? "🟢 Active" : "⚪ Hidden"}</td>
                  <td data-label="Price" class="mini-preview">{service.estimate_text || "No price set"}</td>
                  <td data-label="Description" class="mini-preview">{service.description}</td>

                  <td data-label="Actions" class="actions-cell">
                    <button
                      type="button"
                      class="btn-edit service-edit-btn"
                      data-id={attr(service.id)}
                      data-title={attr(service.title)}
                      data-code={attr(service.service_code)}
                      data-description={attr(service.description)}
                      data-estimate-text={attr(service.estimate_text || "")}
                      data-image-url={attr(service.image_url || "")}
                      data-active={attr(String(service.is_active))}
                    >
                      Edit
                    </button>

                    <button
                      type="button"
                      class="btn-toggle service-toggle-btn"
                      data-id={attr(service.id)}
                      data-current={attr(String(service.is_active))}
                    >
                      {service.is_active ? "Hide" : "Show"}
                    </button>

                    <button type="button" class="btn-delete service-delete-btn" data-id={attr(service.id)}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>

      <section id="business-projects" class="admin-section">
        <div class="section-heading">
          <div>
            <h2 id="project-form-title">Add Portfolio Project</h2>
            <p>
              Add, edit, or delete portfolio examples from your business page.
              Use the same service code as the service it belongs to.
            </p>
          </div>
          <span class="pill">{projectsList.length} projects</span>
        </div>

        <form id="projectForm" class="form-grid">
          <input type="hidden" id="project-id" value="" />

          <div class="two-col">
            <label>
              Project Title
              <input type="text" id="project-title" required placeholder="Inventory Tracker Demo" />
            </label>

            <label>
              Service Code
              <input type="text" id="project-service-code" placeholder="DATA-01" />
              <span class="small-note">
                Match this to a service code. Example: WEB-01 project shows under WEB-01 service.
              </span>
            </label>
          </div>

          <div class="two-col">
            <label>
              Project Category
              <input type="text" id="project-category" placeholder="Spreadsheet / Website / Data Tool" />
            </label>

            <label>
              Project Link URL
              <input type="url" id="project-url" placeholder="https://..." />
            </label>
          </div>

          <label>
            Project Image URL
            <input type="url" id="project-image-url" placeholder="https://..." />
          </label>

          <label>
            Project Description
            <textarea id="project-description" required placeholder="Describe what this project does..."></textarea>
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary" id="project-submit-btn">Save Project</button>
            <button type="button" class="btn-secondary" id="project-clear-btn" style="display: none;">Cancel Edit</button>
          </div>
        </form>

        <h3>Existing Portfolio Projects</h3>
        <table>
          <thead>
            <tr>
              <th>Project</th>
              <th>Code</th>
              <th>Category</th>
              <th>Link</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {projectsList.length === 0 ? (
              <tr>
                <td colspan="6" style="text-align: center; color: var(--muted);">
                  No projects found.
                </td>
              </tr>
            ) : (
              projectsList.map((project: any) => (
                <tr data-project-row-id={project.id}>
                  <td data-label="Project" style="font-weight: bold;">{project.title}</td>
                  <td data-label="Code"><code>{project.service_code || "PROJECT"}</code></td>
                  <td data-label="Category">{project.category || ""}</td>
                  <td data-label="Link" class="image-note">{project.project_url || ""}</td>
                  <td data-label="Description" class="mini-preview">{project.description}</td>

                  <td data-label="Actions" class="actions-cell">
                    <button
                      type="button"
                      class="btn-edit project-edit-btn"
                      data-id={attr(project.id)}
                      data-title={attr(project.title)}
                      data-service-code={attr(project.service_code || "")}
                      data-category={attr(project.category || "")}
                      data-description={attr(project.description || "")}
                      data-image-url={attr(project.image_url || "")}
                      data-project-url={attr(project.project_url || "")}
                    >
                      Edit
                    </button>

                    <button type="button" class="btn-delete project-delete-btn" data-id={attr(project.id)}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>
    </div>

    <script>
      import { supabase } from "../../lib/supabase.js";

      const statusMessage = document.getElementById("status-message") as HTMLDivElement | null;

      function showStatus(message: string, isError = false) {
        if (!statusMessage) return;

        statusMessage.textContent = message;
        statusMessage.className = "status-message " + (isError ? "error" : "success");

        setTimeout(() => {
          statusMessage.className = "status-message";
          statusMessage.textContent = "";
        }, 4500);
      }

      function generateSlug(text: string): string {
        return text
          .toLowerCase()
          .replace(/[^\w\s-]/g, "")
          .replace(/[\s_-]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      function scrollToSection(id: string) {
        const section = document.getElementById(id);
        if (section) section.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      // Blog post admin
      const crudForm = document.getElementById("postCrudForm") as HTMLFormElement;
      const inputId = document.getElementById("post-id") as HTMLInputElement;
      const inputSection = document.getElementById("post-section") as HTMLSelectElement;
      const inputPublished = document.getElementById("post-published") as HTMLSelectElement;
      const inputTitle = document.getElementById("post-title") as HTMLInputElement;
      const inputImageUrl = document.getElementById("post-image-url") as HTMLInputElement;
      const inputExcerpt = document.getElementById("post-excerpt") as HTMLInputElement;
      const inputContent = document.getElementById("post-content") as HTMLTextAreaElement;
      const formActionTitle = document.getElementById("form-action-title") as HTMLHeadingElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const clearFormBtn = document.getElementById("clear-form-btn") as HTMLButtonElement;

      document.querySelectorAll(".post-edit-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const buttonEl = button as HTMLButtonElement;

          inputId.value = buttonEl.dataset.id || "";
          inputTitle.value = buttonEl.dataset.title || "";
          inputSection.value = buttonEl.dataset.section || "curious";
          inputPublished.value = buttonEl.dataset.published || "true";
          inputImageUrl.value = buttonEl.dataset.imageUrl || "";
          inputExcerpt.value = buttonEl.dataset.excerpt || "";
          inputContent.value = buttonEl.dataset.content || "";

          formActionTitle.textContent = `Editing Article: "${inputTitle.value}"`;
          submitBtn.textContent = "Update Existing Post";
          clearFormBtn.style.display = "inline-block";

          scrollToSection("blog-posts");
        });
      });

      clearFormBtn.addEventListener("click", () => {
        crudForm.reset();
        inputId.value = "";
        formActionTitle.textContent = "Create New Post";
        submitBtn.textContent = "Save Post Entry";
        clearFormBtn.style.display = "none";
      });

      crudForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;

        const recordId = inputId.value;
        const cleanTitle = inputTitle.value.trim();

        const payload = {
          title: cleanTitle,
          slug: generateSlug(cleanTitle),
          section: inputSection.value,
          published: inputPublished.value === "true",
          image_url: inputImageUrl.value.trim() || null,
          excerpt: inputExcerpt.value.trim(),
          content: inputContent.value.trim()
        };

        try {
          let error = null;

          if (recordId) {
            const { error: updateError } = await supabase
              .from("posts")
              .update(payload)
              .eq("id", recordId);

            error = updateError;
          } else {
            const { error: insertError } = await supabase
              .from("posts")
              .insert([payload]);

            error = insertError;
          }

          if (error) throw error;

          showStatus("Blog post saved. Reloading admin page...");
          setTimeout(() => window.location.reload(), 900);
        } catch (err: any) {
          showStatus("Database Error: " + err.message, true);
          submitBtn.disabled = false;
        }
      });

      document.querySelectorAll(".post-delete-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const buttonEl = button as HTMLButtonElement;
          const id = buttonEl.dataset.id;
          if (!id) return;

          const verify = confirm("Delete this blog post permanently?");
          if (!verify) return;

          try {
            const { error } = await supabase
              .from("posts")
              .delete()
              .eq("id", id);

            if (error) throw error;

            showStatus("Blog post deleted.");
            const targetRow = document.querySelector(`tr[data-post-row-id="${id}"]`);
            if (targetRow) targetRow.remove();
          } catch (err: any) {
            showStatus("Could not delete post: " + err.message, true);
          }
        });
      });

      // Business contact admin
      const contactForm = document.getElementById("contactForm") as HTMLFormElement;
      const contactId = document.getElementById("contact-id") as HTMLInputElement;
      const businessEmail = document.getElementById("business-email") as HTMLInputElement;
      const businessPhone = document.getElementById("business-phone") as HTMLInputElement;

      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload = {
          business_email: businessEmail.value.trim() || null,
          business_phone: businessPhone.value.trim() || null
        };

        try {
          let error = null;

          if (contactId.value) {
            const { error: updateError } = await supabase
              .from("site_contact")
              .update(payload)
              .eq("id", contactId.value);

            error = updateError;
          } else {
            const { error: insertError } = await supabase
              .from("site_contact")
              .insert([payload]);

            error = insertError;
          }

          if (error) throw error;

          showStatus("Business contact info saved. Reloading...");
          setTimeout(() => window.location.reload(), 900);
        } catch (err: any) {
          showStatus("Could not save contact info: " + err.message, true);
        }
      });

      // Services admin
      const serviceForm = document.getElementById("serviceForm") as HTMLFormElement;
      const serviceId = document.getElementById("service-id") as HTMLInputElement;
      const serviceTitle = document.getElementById("service-title") as HTMLInputElement;
      const serviceCode = document.getElementById("service-code") as HTMLInputElement;
      const serviceImageUrl = document.getElementById("service-image-url") as HTMLInputElement;
      const serviceEstimateText = document.getElementById("service-estimate-text") as HTMLInputElement;
      const serviceDescription = document.getElementById("service-description") as HTMLTextAreaElement;
      const serviceActive = document.getElementById("service-active") as HTMLSelectElement;
      const serviceFormTitle = document.getElementById("service-form-title") as HTMLHeadingElement;
      const serviceSubmitBtn = document.getElementById("service-submit-btn") as HTMLButtonElement;
      const serviceClearBtn = document.getElementById("service-clear-btn") as HTMLButtonElement;

      document.querySelectorAll(".service-edit-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const buttonEl = button as HTMLButtonElement;

          serviceId.value = buttonEl.dataset.id || "";
          serviceTitle.value = buttonEl.dataset.title || "";
          serviceCode.value = buttonEl.dataset.code || "";
          serviceImageUrl.value = buttonEl.dataset.imageUrl || "";
          serviceEstimateText.value = buttonEl.dataset.estimateText || "";
          serviceDescription.value = buttonEl.dataset.description || "";
          serviceActive.value = buttonEl.dataset.active || "true";

          serviceFormTitle.textContent = `Editing Service: "${serviceTitle.value}"`;
          serviceSubmitBtn.textContent = "Update Service";
          serviceClearBtn.style.display = "inline-block";

          scrollToSection("business-services");
        });
      });

      serviceClearBtn.addEventListener("click", () => {
        serviceForm.reset();
        serviceId.value = "";
        serviceFormTitle.textContent = "Add Business Service";
        serviceSubmitBtn.textContent = "Save Service";
        serviceClearBtn.style.display = "none";
      });

      serviceForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        serviceSubmitBtn.disabled = true;

        const payload = {
          title: serviceTitle.value.trim(),
          service_code: serviceCode.value.trim().toUpperCase(),
          description: serviceDescription.value.trim(),
          estimate_text: serviceEstimateText.value.trim() || null,
          image_url: serviceImageUrl.value.trim() || null,
          is_active: serviceActive.value === "true"
        };

        try {
          let error = null;

          if (serviceId.value) {
            const { error: updateError } = await supabase
              .from("services")
              .update(payload)
              .eq("id", serviceId.value);

            error = updateError;
          } else {
            const { error: insertError } = await supabase
              .from("services")
              .insert([payload]);

            error = insertError;
          }

          if (error) throw error;

          showStatus("Service saved. Reloading admin page...");
          setTimeout(() => window.location.reload(), 900);
        } catch (err: any) {
          showStatus("Could not save service: " + err.message, true);
          serviceSubmitBtn.disabled = false;
        }
      });

      document.querySelectorAll(".service-toggle-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const buttonEl = button as HTMLButtonElement;
          const id = buttonEl.dataset.id;
          const current = buttonEl.dataset.current === "true";

          if (!id) return;

          try {
            const { error } = await supabase
              .from("services")
              .update({ is_active: !current })
              .eq("id", id);

            if (error) throw error;

            showStatus(current ? "Service hidden." : "Service made active.");
            setTimeout(() => window.location.reload(), 800);
          } catch (err: any) {
            showStatus("Could not update service status: " + err.message, true);
          }
        });
      });

      document.querySelectorAll(".service-delete-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const buttonEl = button as HTMLButtonElement;
          const id = buttonEl.dataset.id;

          if (!id) return;

          const verify = confirm("Delete this service permanently?");
          if (!verify) return;

          try {
            const { error } = await supabase
              .from("services")
              .delete()
              .eq("id", id);

            if (error) throw error;

            showStatus("Service deleted.");
            const targetRow = document.querySelector(`tr[data-service-row-id="${id}"]`);
            if (targetRow) targetRow.remove();
          } catch (err: any) {
            showStatus("Could not delete service: " + err.message, true);
          }
        });
      });

      // Projects admin
      const projectForm = document.getElementById("projectForm") as HTMLFormElement;

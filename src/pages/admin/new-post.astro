      const projectServiceCode = document.getElementById("project-service-code") as HTMLInputElement;
      const projectCategory = document.getElementById("project-category") as HTMLInputElement;
      const projectUrl = document.getElementById("project-url") as HTMLInputElement;
      const projectImageUrl = document.getElementById("project-image-url") as HTMLInputElement;
      const projectDescription = document.getElementById("project-description") as HTMLTextAreaElement;
      const projectFormTitle = document.getElementById("project-form-title") as HTMLHeadingElement;
      const projectSubmitBtn = document.getElementById("project-submit-btn") as HTMLButtonElement;
      const projectClearBtn = document.getElementById("project-clear-btn") as HTMLButtonElement;

      document.querySelectorAll(".project-edit-btn").forEach((button) => {
        button.addEventListener("click", () => {
          const buttonEl = button as HTMLButtonElement;

          projectId.value = buttonEl.dataset.id || "";
          projectTitle.value = buttonEl.dataset.title || "";
          projectServiceCode.value = buttonEl.dataset.serviceCode || "";
          projectCategory.value = buttonEl.dataset.category || "";
          projectUrl.value = buttonEl.dataset.projectUrl || "";
          projectImageUrl.value = buttonEl.dataset.imageUrl || "";
          projectDescription.value = buttonEl.dataset.description || "";

          projectFormTitle.textContent = `Editing Project: "${projectTitle.value}"`;
          projectSubmitBtn.textContent = "Update Project";
          projectClearBtn.style.display = "inline-block";

          scrollToSection("business-projects");
        });
      });

      projectClearBtn.addEventListener("click", () => {
        projectForm.reset();
        projectId.value = "";
        projectFormTitle.textContent = "Add Portfolio Project";
        projectSubmitBtn.textContent = "Save Project";
        projectClearBtn.style.display = "none";
      });

      projectForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        projectSubmitBtn.disabled = true;

        const payload = {
          title: projectTitle.value.trim(),
          service_code: projectServiceCode.value.trim().toUpperCase() || null,
          category: projectCategory.value.trim() || null,
          description: projectDescription.value.trim(),
          image_url: projectImageUrl.value.trim() || null,
          project_url: projectUrl.value.trim() || null
        };

        try {
          let error = null;

          if (projectId.value) {
            const { error: updateError } = await supabase
              .from("projects")
              .update(payload)
              .eq("id", projectId.value);

            error = updateError;
          } else {
            const { error: insertError } = await supabase
              .from("projects")
              .insert([payload]);

            error = insertError;
          }

          if (error) throw error;

          showStatus("Project saved. Reloading admin page...");
          setTimeout(() => window.location.reload(), 900);
        } catch (err: any) {
          showStatus("Could not save project: " + err.message, true);
          projectSubmitBtn.disabled = false;
        }
      });

      document.querySelectorAll(".project-delete-btn").forEach((button) => {
        button.addEventListener("click", async () => {
          const buttonEl = button as HTMLButtonElement;
          const id = buttonEl.dataset.id;

          if (!id) return;

          const verify = confirm("Delete this portfolio project permanently?");
          if (!verify) return;

          try {
            const { error } = await supabase
              .from("projects")
              .delete()
              .eq("id", id);

            if (error) throw error;

            showStatus("Project deleted.");
            const targetRow = document.querySelector(`tr[data-project-row-id="${id}"]`);
            if (targetRow) targetRow.remove();
          } catch (err: any) {
            showStatus("Could not delete project: " + err.message, true);
          }
        });
      });
    </script>
  </body>

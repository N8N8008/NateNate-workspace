---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin Login">
  <main class="admin-page">
    <section class="login-card">
      <p class="eyebrow">Admin Area</p>
      <h1>Login</h1>
      <p class="intro-text">
        Log in with your Supabase admin account to create blog posts.
      </p>

      <form id="loginForm">
        <label>
          Email
          <input type="email" id="email" required />
        </label>

        <label>
          Password
          <input type="password" id="password" required />
        </label>

        <button type="submit">Log In</button>
      </form>

      <p id="message">JavaScript has not loaded yet.</p>
    </section>
  </main>

  <style>
    .admin-page {
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f7f4ef;
      color: #1f1f1f;
      font-family: Georgia, serif;
      padding: 30px;
    }

    .login-card {
      width: min(430px, 100%);
      background: white;
      padding: 36px;
      border-radius: 28px;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.1);
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: #7a6248;
      font-size: 0.75rem;
      margin: 0 0 8px;
    }

    h1 {
      margin: 0;
      font-size: 2.4rem;
    }

    .intro-text {
      color: #5f554b;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    form {
      display: grid;
      gap: 18px;
    }

    label {
      display: grid;
      gap: 8px;
      font-weight: bold;
    }

    input {
      padding: 13px 14px;
      border: 1px solid #d7cbbd;
      border-radius: 14px;
      font-size: 1rem;
      font-family: inherit;
    }

    button {
      border: none;
      border-radius: 999px;
      padding: 13px 20px;
      background: #2b2520;
      color: white;
      cursor: pointer;
      font-size: 1rem;
      font-family: inherit;
    }

    button:hover {
      background: #5b4634;
    }

    #message {
      margin-top: 16px;
      color: #8a2e2e;
      line-height: 1.5;
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";

    document.addEventListener("DOMContentLoaded", () => {
      const message = document.getElementById("message");
      const form = document.getElementById("loginForm");
      const emailInput = document.getElementById("email");
      const passwordInput = document.getElementById("password");

      if (
        !(message instanceof HTMLElement) ||
        !(form instanceof HTMLFormElement) ||
        !(emailInput instanceof HTMLInputElement) ||
        !(passwordInput instanceof HTMLInputElement)
      ) {
        console.error("Could not find the login form, message, email, or password input.");
        return;
      }

      message.style.color = "#395f35";
      message.textContent = "JavaScript loaded. Ready to log in.";

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        message.style.color = "#7a6248";
        message.textContent = "Logging in...";

        const { data, error } = await supabase.auth.signInWithPassword({
          email: emailInput.value.trim(),
          password: passwordInput.value,
        });

        console.log("Login data:", data);
        console.log("Login error:", error);

        if (error) {
          message.style.color = "#8a2e2e";
          message.textContent = "Login failed: " + error.message;
          alert("Login failed: " + error.message);
          return;
        }

        message.style.color = "#395f35";
        message.textContent = "Login worked. Taking you to the editor...";
        alert("Login worked");

        window.location.href = "/admin/new-post";
      });
    });
  </script>
</Layout>
---
import { supabase } from "../../lib/supabase.js";

const title = "Admin Portal | Look Up";

const { data: allPosts, error: fetchError } = await supabase
  .from("posts")
  .select("*")
  .order("created_at", { ascending: false });

if (fetchError) {
  console.error("Error loading dashboard posts:", fetchError.message);
}

const { data: contactData } = await supabase
  .from("site_contact")
  .select("*")
  .limit(1)
  .single();

const { data: allServices } = await supabase
  .from("services")
  .select("*")
  .order("id", { ascending: true });

const { data: allProjects } = await supabase
  .from("projects")
  .select("*")
  .order("id", { ascending: false });

const { data: allRequests } = await supabase
  .from("service_requests")
  .select("*")
  .order("created_at", { ascending: false });

const postsList = allPosts || [];
const servicesList = allServices || [];
const projectsList = allProjects || [];
const requestsList = allRequests || [];

function makeSlug(title = "") {
  return title
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="dashboard-container">
      <div class="top-links">
        <a href="/content">← Back to Public Collection</a>
        <a href="/business">View Business Page</a>
        <a href="/admin/login">Admin Login</a>
      </div>

      <h1>Control Panel Dashboard</h1>
      <p class="subtext">
        Manage your blog posts, business services, contact information, example
        projects, and customer service requests.
      </p>

      <div id="status-message"></div>

      <nav class="admin-tabs">
        <a href="#blog-posts">Blog Posts</a>
        <a href="#business-contact">Contact Info</a>
        <a href="#business-services">Services</a>
        <a href="#business-projects">Projects</a>
        <a href="#customer-requests">Requests</a>
      </nav>

      <section id="blog-posts" class="panel">
        <h2 id="form-action-title">Create New Post</h2>

        <form id="postCrudForm" class="form-grid">
          <input type="hidden" id="post-id" value="" />

          <div class="two-column">
            <label>
              Section Location
              <select id="post-section" required>
                <option value="curious">Curiosity Notes</option>
                <option value="research">Research & Reports</option>
              </select>
            </label>

            <label>
              Publication Status
              <select id="post-published">
                <option value="true">Published (Live)</option>
                <option value="false">Draft (Hidden)</option>
              </select>
            </label>
          </div>

          <label>
            Article Title
            <input type="text" id="post-title" required />
          </label>

          <label>
            Feature Image URL
            <input type="url" id="post-image-url" />
          </label>

          <label>
            Excerpt / Short Summary
            <input type="text" id="post-excerpt" required />
          </label>

          <label>
            Full Content Material
            <textarea id="post-content" required></textarea>
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary" id="submit-btn">
              Save Post Entry
            </button>
            <button type="button" class="btn-secondary" id="clear-form-btn">
              Cancel Edit
            </button>
          </div>
        </form>

        <h2>Blog Inventory</h2>

        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Section</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {postsList.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-cell">
                  No blog posts found.
                </td>
              </tr>
            ) : (
              postsList.map((post: any) => (
                <tr data-row-id={post.id}>
                  <td class="bold-cell">{post.title}</td>
                  <td>
                    <code>{post.section}</code>
                  </td>
                  <td>{post.published ? "🟢 Live" : "⚪ Draft"}</td>
                  <td class="actions-cell">
                    <button
                      class="btn-edit"
                      data-id={post.id}
                      data-title={post.title}
                      data-section={post.section}
                      data-published={String(post.published)}
                      data-image_url={post.image_url || ""}
                      data-excerpt={post.excerpt || post.preview || ""}
                      data-content={post.content || ""}
                    >
                      Edit
                    </button>

                    <button class="btn-delete" data-id={post.id}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>

      <section id="business-contact" class="panel">
        <h2>Business Contact Info</h2>

        <form id="contactForm" class="form-grid">
          <input type="hidden" id="contact-id" value={contactData?.id || ""} />

          <label>
            Business Email
            <input
              type="email"
              id="business-email"
              value={contactData?.business_email || ""}
              placeholder="your-email@example.com"
            />
          </label>

          <label>
            Business Phone
            <input
              type="text"
              id="business-phone"
              value={contactData?.business_phone || ""}
              placeholder="(123) 456-7890"
            />
          </label>

          <button type="submit" class="btn-primary">
            Save Contact Info
          </button>
        </form>
      </section>

      <section id="business-services" class="panel">
        <h2 id="service-action-title">Add Business Service</h2>

        <form id="serviceForm" class="form-grid">
          <input type="hidden" id="service-id" />

          <div class="two-column">
            <label>
              Service Title
              <input type="text" id="service-title" required />
            </label>

            <label>
              Service Code
              <input type="text" id="service-code" required placeholder="WEB-001" />
            </label>
          </div>

          <label>
            Description
            <textarea id="service-description" required></textarea>
          </label>

          <label>
            Image URL
            <input
              type="text"
              id="service-image"
              placeholder="/images/website-design.jpg"
            />
          </label>

          <label class="check-label">
            <input type="checkbox" id="service-active" checked />
            Show this service on the business page
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary">Save Service</button>
            <button type="button" class="btn-secondary" id="clear-service-btn">
              Cancel Edit
            </button>
          </div>
        </form>

        <h2>Current Services</h2>

        <table>
          <thead>
            <tr>
              <th>Service</th>
              <th>Code</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {servicesList.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-cell">No services found.</td>
              </tr>
            ) : (
              servicesList.map((service: any) => (
                <tr data-service-row-id={service.id}>
                  <td class="bold-cell">{service.title}</td>
                  <td>
                    <code>{service.service_code}</code>
                  </td>
                  <td>{service.is_active ? "🟢 Showing" : "⚪ Hidden"}</td>
                  <td class="actions-cell">
                    <button
                      class="btn-edit-service"
                      data-id={service.id}
                      data-title={service.title}
                      data-code={service.service_code}
                      data-description={service.description}
                      data-image={service.image_url || ""}
                      data-active={String(service.is_active)}
                    >
                      Edit
                    </button>

                    <button class="btn-delete-service" data-id={service.id}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>

      <section id="business-projects" class="panel">
        <h2 id="project-action-title">Add Example Project</h2>

        <form id="projectForm" class="form-grid">
          <input type="hidden" id="project-id" />

          <div class="two-column">
            <label>
              Project Title
              <input type="text" id="project-title" required />
            </label>

            <label>
              Service Code
              <input type="text" id="project-service-code" placeholder="WEB-001" />
            </label>
          </div>

          <label>
            Category
            <input type="text" id="project-category" placeholder="Website Design" />
          </label>

          <label>
            Description
            <textarea id="project-description"></textarea>
          </label>

          <label>
            Image URL
            <input
              type="text"
              id="project-image"
              placeholder="/images/project-blog.jpg"
            />
          </label>

          <div class="btn-group">
            <button type="submit" class="btn-primary">Save Project</button>
            <button type="button" class="btn-secondary" id="clear-project-btn">
              Cancel Edit
            </button>
          </div>
        </form>

        <h2>Current Example Projects</h2>

        <table>
          <thead>
            <tr>
              <th>Project</th>
              <th>Code</th>
              <th>Category</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {projectsList.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-cell">No projects found.</td>
              </tr>
            ) : (
              projectsList.map((project: any) => (
                <tr data-project-row-id={project.id}>
                  <td class="bold-cell">{project.title}</td>
                  <td>
                    <code>{project.service_code || "None"}</code>
                  </td>
                  <td>{project.category}</td>
                  <td class="actions-cell">
                    <button
                      class="btn-edit-project"
                      data-id={project.id}
                      data-title={project.title}
                      data-code={project.service_code || ""}
                      data-category={project.category || ""}
                      data-description={project.description || ""}
                      data-image={project.image_url || ""}
                    >
                      Edit
                    </button>

                    <button class="btn-delete-project" data-id={project.id}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>

      <section id="customer-requests" class="panel">
        <h2>Customer Service Requests</h2>

        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Email</th>
              <th>Service</th>
              <th>Status</th>
              <th>Message</th>
            </tr>
          </thead>

          <tbody>
            {requestsList.length === 0 ? (
              <tr>
                <td colspan="5" class="empty-cell">No customer requests yet.</td>
              </tr>
            ) : (
              requestsList.map((request: any) => (
                <tr>
                  <td class="bold-cell">{request.customer_name || "Customer"}</td>
                  <td>{request.customer_email}</td>
                  <td>
                    <code>{request.service_code}</code>
                  </td>
                  <td>{request.status || "New"}</td>
                  <td>{request.message}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </section>
    </div>

    <script>
      import { supabase } from "../../lib/supabase.js";

      const statusMessage = document.getElementById("status-message") as HTMLDivElement;

      function showStatus(message: string, isError = false) {
        if (!statusMessage) return;
        statusMessage.textContent = message;
        statusMessage.style.display = "block";
        statusMessage.style.background = isError ? "var(--danger)" : "var(--success)";
        statusMessage.style.color = "white";
        setTimeout(() => {
          statusMessage.style.display = "none";
        }, 4000);
      }

      function slugify(value: string) {
        return value
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)/g, "");
      }

      const crudForm = document.getElementById("postCrudForm") as HTMLFormElement;
      const inputId = document.getElementById("post-id") as HTMLInputElement;
      const inputSection = document.getElementById("post-section") as HTMLSelectElement;
      const inputPublished = document.getElementById("post-published") as HTMLSelectElement;
      const inputTitle = document.getElementById("post-title") as HTMLInputElement;
      const inputImageUrl = document.getElementById("post-image-url") as HTMLInputElement;
      const inputExcerpt = document.getElementById("post-excerpt") as HTMLInputElement;
      const inputContent = document.getElementById("post-content") as HTMLTextAreaElement;
      const formActionTitle = document.getElementById("form-action-title") as HTMLHeadingElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const clearFormBtn = document.getElementById("clear-form-btn") as HTMLButtonElement;

      clearFormBtn.style.display = "none";

      document.querySelectorAll(".btn-edit").forEach((button) => {
        button.addEventListener("click", () => {
          inputId.value = button.getAttribute("data-id") || "";
          inputTitle.value = button.getAttribute("data-title") || "";
          inputSection.value = button.getAttribute("data-section") || "curious";
          inputPublished.value = button.getAttribute("data-published") || "true";
          inputImageUrl.value = button.getAttribute("data-image_url") || "";
          inputExcerpt.value = button.getAttribute("data-excerpt") || "";
          inputContent.value = button.getAttribute("data-content") || "";

          formActionTitle.textContent = `Editing Article: "${inputTitle.value}"`;
          submitBtn.textContent = "Update Existing Post";
          clearFormBtn.style.display = "inline-block";
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      });

      clearFormBtn.addEventListener("click", () => {
        crudForm.reset();
        inputId.value = "";
        formActionTitle.textContent = "Create New Post";
        submitBtn.textContent = "Save Post Entry";
        clearFormBtn.style.display = "none";
      });

      crudForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;

        const recordId = inputId.value;
        const payload = {
          title: inputTitle.value.trim(),
          slug: slugify(inputTitle.value.trim()),
          section: inputSection.value,
          published: inputPublished.value === "true",
          image_url: inputImageUrl.value.trim() || null,
          excerpt: inputExcerpt.value.trim(),
          preview: inputExcerpt.value.trim(),
          content: inputContent.value.trim(),
          updated_at: new Date().toISOString(),
        };

        try {
          let error = null;

          if (recordId) {
            const result = await supabase
              .from("posts")
              .update(payload)
              .eq("id", recordId);

            error = result.error;
          } else {
            const result = await supabase.from("posts").insert([payload]);
            error = result.error;
          }

          if (error) throw error;

          showStatus("Post saved.");
          setTimeout(() => window.location.reload(), 900);
        } catch (err: any) {
          showStatus("Post error: " + err.message, true);
          submitBtn.disabled = false;
        }
      });

      document.querySelectorAll(".btn-delete").forEach((button) => {
        button.addEventListener("click", async () => {
          const id = button.getAttribute("data-id");
          if (!id) return;

          const verify = confirm("Delete this blog post?");
          if (!verify) return;

          const { error } = await supabase.from("posts").delete().eq("id", id);

          if (error) {
            showStatus(error.message, true);
            return;
          }

          showStatus("Post deleted.");
          document.querySelector(`tr[data-row-id="${id}"]`)?.remove();
        });
      });

      const contactForm = document.getElementById("contactForm") as HTMLFormElement;
      const contactId = document.getElementById("contact-id") as HTMLInputElement;
      const businessEmail = document.getElementById("business-email") as HTMLInputElement;
      const businessPhone = document.getElementById("business-phone") as HTMLInputElement;

      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload = {
          business_email: businessEmail.value.trim(),
          business_phone: businessPhone.value.trim(),
          updated_at: new Date().toISOString(),
        };

        let error = null;

        if (contactId.value) {
          const result = await supabase
            .from("site_contact")
            .update(payload)
            .eq("id", contactId.value);

          error = result.error;
        } else {
          const result = await supabase.from("site_contact").insert([payload]);
          error = result.error;
        }

        if (error) {
          showStatus(error.message, true);
          return;
        }

        showStatus("Contact info saved.");
        setTimeout(() => window.location.reload(), 900);
      });

      const serviceForm = document.getElementById("serviceForm") as HTMLFormElement;
      const serviceId = document.getElementById("service-id") as HTMLInputElement;
      const serviceTitle = document.getElementById("service-title") as HTMLInputElement;
      const serviceCode = document.getElementById("service-code") as HTMLInputElement;
      const serviceDescription = document.getElementById("service-description") as HTMLTextAreaElement;
      const serviceImage = document.getElementById("service-image") as HTMLInputElement;
      const serviceActive = document.getElementById("service-active") as HTMLInputElement;
      const serviceActionTitle = document.getElementById("service-action-title") as HTMLHeadingElement;
      const clearServiceBtn = document.getElementById("clear-service-btn") as HTMLButtonElement;

      clearServiceBtn.style.display = "none";

      function clearServiceForm() {
        serviceForm.reset();
        serviceId.value = "";
        serviceActive.checked = true;
        serviceActionTitle.textContent = "Add Business Service";
        clearServiceBtn.style.display = "none";
      }

      clearServiceBtn.addEventListener("click", clearServiceForm);

      document.querySelectorAll(".btn-edit-service").forEach((button) => {
        button.addEventListener("click", () => {
          serviceId.value = button.getAttribute("data-id") || "";
          serviceTitle.value = button.getAttribute("data-title") || "";
          serviceCode.value = button.getAttribute("data-code") || "";
          serviceDescription.value = button.getAttribute("data-description") || "";
          serviceImage.value = button.getAttribute("data-image") || "";
          serviceActive.checked = button.getAttribute("data-active") === "true";

          serviceActionTitle.textContent = `Editing Service: "${serviceTitle.value}"`;
          clearServiceBtn.style.display = "inline-block";
          document.querySelector("#business-services")?.scrollIntoView({ behavior: "smooth" });
        });
      });

      serviceForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload = {
          title: serviceTitle.value.trim(),
          service_code: serviceCode.value.trim(),
          description: serviceDescription.value.trim(),
          image_url: serviceImage.value.trim() || null,
          is_active: serviceActive.checked,
          updated_at: new Date().toISOString(),
        };

        let error = null;

        if (serviceId.value) {
          const result = await supabase
            .from("services")
            .update(payload)
            .eq("id", serviceId.value);

          error = result.error;
        } else {
          const result = await supabase.from("services").insert([payload]);
          error = result.error;
        }

        if (error) {
          showStatus(error.message, true);
          return;
        }

        showStatus("Service saved.");
        setTimeout(() => window.location.reload(), 900);
      });

      document.querySelectorAll(".btn-delete-service").forEach((button) => {
        button.addEventListener("click", async () => {
          const id = button.getAttribute("data-id");
          if (!id) return;

          const verify = confirm("Delete this service?");
          if (!verify) return;

          const { error } = await supabase.from("services").delete().eq("id", id);

          if (error) {
            showStatus(error.message, true);
            return;
          }

          showStatus("Service deleted.");
          setTimeout(() => window.location.reload(), 900);
        });
      });

      const projectForm = document.getElementById("projectForm") as HTMLFormElement;
      const projectId = document.getElementById("project-id") as HTMLInputElement;
      const projectTitle = document.getElementById("project-title") as HTMLInputElement;
      const projectServiceCode = document.getElementById("project-service-code") as HTMLInputElement;
      const projectCategory = document.getElementById("project-category") as HTMLInputElement;
      const projectDescription = document.getElementById("project-description") as HTMLTextAreaElement;
      const projectImage = document.getElementById("project-image") as HTMLInputElement;
      const projectActionTitle = document.getElementById("project-action-title") as HTMLHeadingElement;
      const clearProjectBtn = document.getElementById("clear-project-btn") as HTMLButtonElement;

      clearProjectBtn.style.display = "none";

      function clearProjectForm() {
        projectForm.reset();
        projectId.value = "";
        projectActionTitle.textContent = "Add Example Project";
        clearProjectBtn.style.display = "none";
      }

      clearProjectBtn.addEventListener("click", clearProjectForm);

      document.querySelectorAll(".btn-edit-project").forEach((button) => {
        button.addEventListener("click", () => {
          projectId.value = button.getAttribute("data-id") || "";
          projectTitle.value = button.getAttribute("data-title") || "";
          projectServiceCode.value = button.getAttribute("data-code") || "";
          projectCategory.value = button.getAttribute("data-category") || "";
          projectDescription.value = button.getAttribute("data-description") || "";
          projectImage.value = button.getAttribute("data-image") || "";

          projectActionTitle.textContent = `Editing Project: "${projectTitle.value}"`;
          clearProjectBtn.style.display = "inline-block";
          document.querySelector("#business-projects")?.scrollIntoView({ behavior: "smooth" });
        });
      });

      projectForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const payload = {
          title: projectTitle.value.trim(),
          service_code: projectServiceCode.value.trim() || null,
          category: projectCategory.value.trim(),
          description: projectDescription.value.trim(),
          image_url: projectImage.value.trim() || null,
          updated_at: new Date().toISOString(),
        };

        let error = null;

        if (projectId.value) {
          const result = await supabase
            .from("projects")
            .update(payload)
            .eq("id", projectId.value);

          error = result.error;
        } else {
          const result = await supabase.from("projects").insert([payload]);
          error = result.error;
        }

        if (error) {
          showStatus(error.message, true);
          return;
        }

        showStatus("Project saved.");
        setTimeout(() => window.location.reload(), 900);
      });

      document.querySelectorAll(".btn-delete-project").forEach((button) => {
        button.addEventListener("click", async () => {
          const id = button.getAttribute("data-id");
          if (!id) return;

          const verify = confirm("Delete this project?");
          if (!verify) return;

          const { error } = await supabase.from("projects").delete().eq("id", id);

          if (error) {
            showStatus(error.message, true);
            return;
          }

          showStatus("Project deleted.");
          setTimeout(() => window.location.reload(), 900);
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #f8f7f3;
    --paper: #ffffff;
    --text: #1d2430;
    --muted: #687385;
    --line: #d9dee7;
    --accent: #263b59;
    --accent-soft: #e7ecf3;
    --danger: #a63a3a;
    --success: #2e5630;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    padding: 40px 20px;
  }

  .dashboard-container {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--paper);
    padding: 32px;
    border-radius: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  h1,
  h2 {
    font-family: Georgia, serif;
    margin-top: 0;
  }

  .subtext {
    color: var(--muted);
    line-height: 1.6;
  }

  .top-links,
  .admin-tabs,
  .btn-group,
  .actions-cell {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .top-links a,
  .admin-tabs a {
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: bold;
    background: var(--accent-soft);
    padding: 8px 12px;
    border-radius: 999px;
  }

  .admin-tabs {
    margin: 24px 0;
  }

  .panel {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .form-grid {
    display: grid;
    gap: 16px;
    background: var(--bg);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid var(--line);
    margin-bottom: 40px;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: bold;
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--accent);
  }

  .check-label {
    flex-direction: row;
    align-items: center;
  }

  .check-label input {
    width: auto;
  }

  input,

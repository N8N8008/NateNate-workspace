---
const title = "Admin Dashboard | Look Up";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="dashboard-shell">
      <aside class="sidebar">
        <div class="brand-block">
          <p class="eyebrow">Look Up Admin</p>
          <h1>Dashboard</h1>
          <p>
            Edit your blog posts, business services, portfolio projects, contact
            info, and customer requests.
          </p>
        </div>

        <nav class="side-nav">
          <a href="#overview">Overview</a>
          <a href="#blog-posts">Blog Posts</a>
          <a href="#business-contact">Contact Info</a>
          <a href="#business-services">Services</a>
          <a href="#business-projects">Projects</a>
          <a href="#customer-requests">Requests</a>
        </nav>

        <div class="sidebar-links">
          <a href="/content">Public Content</a>
          <a href="/business">Business Page</a>
          <a href="/admin/login">Login Page</a>
          <button id="logout-btn" class="logout-button">Log Out</button>
        </div>
      </aside>

      <main class="main-panel">
        <div id="status-message"></div>

        <section id="auth-check" class="panel">
          <h2>Checking admin access...</h2>
          <p class="muted">
            If you are not logged in as an admin, you will be sent back to the
            login page.
          </p>
        </section>

        <div id="dashboard-content" class="hidden">
          <section id="overview" class="overview-grid">
            <article class="stat-card">
              <span id="post-count">0</span>
              <p>Blog Posts</p>
            </article>

            <article class="stat-card">
              <span id="service-count">0</span>
              <p>Services</p>
            </article>

            <article class="stat-card">
              <span id="project-count">0</span>
              <p>Projects</p>
            </article>

            <article class="stat-card">
              <span id="request-count">0</span>
              <p>Requests</p>
            </article>
          </section>

          <section id="blog-posts" class="panel">
            <h2 id="post-action-title">Create New Post</h2>

            <form id="postForm" class="form-grid">
              <input type="hidden" id="post-id" />

              <div class="two-column">
                <label>
                  Section
                  <select id="post-section" required>
                    <option value="curious">Curiosity Notes</option>
                    <option value="research">Research & Reports</option>
                  </select>
                </label>

                <label>
                  Status
                  <select id="post-published">
                    <option value="true">Published</option>
                    <option value="false">Draft</option>
                  </select>
                </label>
              </div>

              <label>
                Article Title
                <input type="text" id="post-title" required />
              </label>

              <label>
                Image URL
                <input type="text" id="post-image-url" placeholder="/images/example.jpg" />
              </label>

              <label>
                Short Summary
                <input type="text" id="post-excerpt" required />
              </label>

              <label>
                Full Article Content
                <textarea id="post-content" required></textarea>
              </label>

              <div class="btn-group">
                <button type="submit" class="btn-primary" id="post-submit-btn">
                  Save Post
                </button>

                <button type="button" class="btn-secondary" id="clear-post-btn">
                  Cancel Edit
                </button>
              </div>
            </form>

            <h3>Blog Inventory</h3>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Section</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody id="posts-table-body">
                  <tr>
                    <td colspan="4" class="empty-cell">Loading posts...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section id="business-contact" class="panel">
            <h2>Business Contact Info</h2>

            <form id="contactForm" class="form-grid">
              <input type="hidden" id="contact-id" />

              <div class="two-column">
                <label>
                  Business Name
                  <input type="text" id="business-name" placeholder="Your Business Name" />
                </label>

                <label>
                  Location
                  <input type="text" id="business-location" placeholder="Brevard County, FL" />
                </label>
              </div>

              <div class="two-column">
                <label>
                  Business Email
                  <input type="email" id="business-email" placeholder="your-email@example.com" />
                </label>

                <label>
                  Business Phone
                  <input type="text" id="business-phone" placeholder="(123) 456-7890" />
                </label>
              </div>

              <div class="two-column">
                <label>
                  Facebook URL
                  <input type="text" id="facebook-url" />
                </label>

                <label>
                  Instagram URL
                  <input type="text" id="instagram-url" />
                </label>
              </div>

              <label>
                Website URL
                <input type="text" id="website-url" />
              </label>

              <button type="submit" class="btn-primary">
                Save Contact Info
              </button>
            </form>
          </section>

          <section id="business-services" class="panel">
            <h2 id="service-action-title">Add Business Service</h2>

            <form id="serviceForm" class="form-grid">
              <input type="hidden" id="service-id" />

              <div class="two-column">
                <label>
                  Service Title
                  <input type="text" id="service-title" required />
                </label>

                <label>
                  Service Code
                  <input type="text" id="service-code" required placeholder="WEB-001" />
                </label>
              </div>

              <label>
                Short Description
                <textarea
                  id="service-short-description"
                  placeholder="Short text that appears on the business page card."
                  required
                ></textarea>
              </label>

              <label>
                Full Description
                <textarea
                  id="service-description"
                  placeholder="Longer explanation of the service."
                ></textarea>
              </label>

              <label>
                Estimate Text
                <input
                  type="text"
                  id="service-estimate"
                  placeholder="Starting around $75 depending on project size."
                />
              </label>

              <label>
                Image URL
                <input type="text" id="service-image" placeholder="/images/service.jpg" />
              </label>

              <label class="check-label">
                <input type="checkbox" id="service-active" checked />
                Show this service on the public business page
              </label>

              <div class="btn-group">
                <button type="submit" class="btn-primary">Save Service</button>

                <button type="button" class="btn-secondary" id="clear-service-btn">
                  Cancel Edit
                </button>
              </div>
            </form>

            <h3>Current Services</h3>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Service</th>
                    <th>Code</th>
                    <th>Estimate</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody id="services-table-body">
                  <tr>
                    <td colspan="5" class="empty-cell">Loading services...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section id="business-projects" class="panel">
            <h2 id="project-action-title">Add Example Project</h2>

            <form id="projectForm" class="form-grid">
              <input type="hidden" id="project-id" />

              <div class="two-column">
                <label>
                  Project Title
                  <input type="text" id="project-title" required />
                </label>

                <label>
                  Related Service
                  <select id="project-service-code">
                    <option value="">No service selected</option>
                  </select>
                </label>
              </div>

              <label>
                Category
                <input type="text" id="project-category" placeholder="Website Design" />
              </label>

              <label>
                Description
                <textarea id="project-description"></textarea>
              </label>

              <label>
                Image URL
                <input type="text" id="project-image" placeholder="/images/project.jpg" />
              </label>

              <label>
                Project URL
                <input type="text" id="project-url" placeholder="https://example.com" />
              </label>

              <label class="check-label">
                <input type="checkbox" id="project-featured" />
                Feature this project
              </label>

              <div class="btn-group">
                <button type="submit" class="btn-primary">Save Project</button>

                <button type="button" class="btn-secondary" id="clear-project-btn">
                  Cancel Edit
                </button>
              </div>
            </form>

            <h3>Current Projects</h3>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Project</th>
                    <th>Service</th>
                    <th>Category</th>
                    <th>Featured</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody id="projects-table-body">
                  <tr>
                    <td colspan="5" class="empty-cell">Loading projects...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section id="customer-requests" class="panel">
            <h2>Customer Service Requests</h2>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Service</th>
                    <th>Status</th>
                    <th>Project Details</th>
                    <th>Admin Notes</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody id="requests-table-body">
                  <tr>
                    <td colspan="7" class="empty-cell">Loading requests...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </main>
    </div>

    <script type="module">
      // @ts-nocheck
      import { supabase } from "../../lib/supabase.js";

      let posts = [];
      let services = [];
      let projects = [];
      let requests = [];
      let contact = null;

      const statusMessage = document.getElementById("status-message");
      const authCheck = document.getElementById("auth-check");
      const dashboardContent = document.getElementById("dashboard-content");

      const postCount = document.getElementById("post-count");
      const serviceCount = document.getElementById("service-count");
      const projectCount = document.getElementById("project-count");
      const requestCount = document.getElementById("request-count");

      const postsTableBody = document.getElementById("posts-table-body");
      const servicesTableBody = document.getElementById("services-table-body");
      const projectsTableBody = document.getElementById("projects-table-body");
      const requestsTableBody = document.getElementById("requests-table-body");

      function showStatus(message, isError = false) {
        if (!statusMessage) return;

        statusMessage.textContent = message;
        statusMessage.className = isError ? "status error" : "status success";
        statusMessage.style.display = "block";

        setTimeout(() => {
          statusMessage.style.display = "none";
        }, 4000);
      }

      function escapeHTML(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function slugify(value) {
        return String(value || "")
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)/g, "");
      }

      async function checkAdminAccess() {
        const {
          data: { user },
          error: userError,
        } = await supabase.auth.getUser();

        if (userError || !user) {
          window.location.href = "/admin/login";
          return false;
        }

        const { data: isAdmin, error: adminError } = await supabase.rpc("is_admin");

        if (adminError || !isAdmin) {
          showStatus("You are logged in, but this account is not an admin.", true);
          setTimeout(() => {
            window.location.href = "/admin/login";
          }, 1400);
          return false;
        }

        authCheck.classList.add("hidden");
        dashboardContent.classList.remove("hidden");
        return true;
      }

      async function loadDashboardData() {
        const [
          postsResult,
          contactResult,
          servicesResult,
          projectsResult,
          requestsResult,
        ] = await Promise.all([
          supabase.from("posts").select("*").order("created_at", { ascending: false }),

          supabase
            .from("site_contact")
            .select("*")
            .order("updated_at", { ascending: false })
            .limit(1)
            .maybeSingle(),

          supabase.from("services").select("*").order("id", { ascending: true }),
          supabase.from("projects").select("*").order("created_at", { ascending: false }),
          supabase.from("service_requests").select("*").order("created_at", { ascending: false }),
        ]);

        if (postsResult.error) showStatus(postsResult.error.message, true);
        if (contactResult.error) showStatus(contactResult.error.message, true);
        if (servicesResult.error) showStatus(servicesResult.error.message, true);
        if (projectsResult.error) showStatus(projectsResult.error.message, true);
        if (requestsResult.error) showStatus(requestsResult.error.message, true);

        posts = postsResult.data || [];
        contact = contactResult.data || null;
        services = servicesResult.data || [];
        projects = projectsResult.data || [];
        requests = requestsResult.data || [];

        renderEverything();
      }

      function renderEverything() {
        postCount.textContent = String(posts.length);
        serviceCount.textContent = String(services.length);
        projectCount.textContent = String(projects.length);
        requestCount.textContent = String(requests.length);

        renderContactForm();
        renderServiceOptions();
        renderPosts();
        renderServices();
        renderProjects();
        renderRequests();
      }

      function renderContactForm() {
        document.getElementById("contact-id").value = contact?.id || "";
        document.getElementById("business-name").value = contact?.business_name || "";
        document.getElementById("business-location").value = contact?.business_location || "";
        document.getElementById("business-email").value = contact?.business_email || "";
        document.getElementById("business-phone").value = contact?.business_phone || "";
        document.getElementById("facebook-url").value = contact?.facebook_url || "";
        document.getElementById("instagram-url").value = contact?.instagram_url || "";
        document.getElementById("website-url").value = contact?.website_url || "";
      }

      function renderServiceOptions() {
        const projectServiceSelect = document.getElementById("project-service-code");

        projectServiceSelect.innerHTML = `
          <option value="">No service selected</option>
          ${services
            .map(
              (service) => `
                <option value="${escapeHTML(service.service_code)}">
                  ${escapeHTML(service.title)} (${escapeHTML(service.service_code)})
                </option>
              `
            )
            .join("")}
        `;
      }

      function renderPosts() {
        if (!posts.length) {
          postsTableBody.innerHTML = `
            <tr>
              <td colspan="4" class="empty-cell">No blog posts found.</td>
            </tr>
          `;
          return;
        }

        postsTableBody.innerHTML = posts
          .map(
            (post) => `
              <tr>
                <td class="bold-cell">${escapeHTML(post.title)}</td>
                <td><code>${escapeHTML(post.section)}</code></td>
                <td>${post.published ? "🟢 Published" : "⚪ Draft"}</td>
                <td class="actions-cell">
                  <button class="btn-edit" data-action="edit" data-type="post" data-id="${post.id}">
                    Edit
                  </button>
                  <button class="btn-delete" data-action="delete" data-type="post" data-id="${post.id}">
                    Delete
                  </button>
                </td>
              </tr>
            `
          )
          .join("");
      }

      function renderServices() {
        if (!services.length) {
          servicesTableBody.innerHTML = `
            <tr>
              <td colspan="5" class="empty-cell">No services found.</td>
            </tr>
          `;
          return;
        }

        servicesTableBody.innerHTML = services
          .map(
            (service) => `
              <tr>
                <td class="bold-cell">${escapeHTML(service.title)}</td>
                <td><code>${escapeHTML(service.service_code)}</code></td>
                <td>${escapeHTML(service.estimate_text || "No estimate")}</td>
                <td>${service.is_active ? "🟢 Showing" : "⚪ Hidden"}</td>
                <td class="actions-cell">
                  <button class="btn-edit" data-action="edit" data-type="service" data-id="${service.id}">
                    Edit
                  </button>
                  <button class="btn-delete" data-action="delete" data-type="service" data-id="${service.id}">
                    Delete
                  </button>
                </td>
              </tr>
            `
          )
          .join("");
      }

      function renderProjects() {
        if (!projects.length) {
          projectsTableBody.innerHTML = `
            <tr>
              <td colspan="5" class="empty-cell">No projects found.</td>
            </tr>
          `;
          return;
        }

        projectsTableBody.innerHTML = projects
          .map(
            (project) => `
              <tr>
                <td class="bold-cell">${escapeHTML(project.title)}</td>
                <td><code>${escapeHTML(project.service_code || "None")}</code></td>
                <td>${escapeHTML(project.category || "")}</td>
                <td>${project.is_featured ? "⭐ Featured" : "Regular"}</td>
                <td class="actions-cell">
                  <button class="btn-edit" data-action="edit" data-type="project" data-id="${project.id}">
                    Edit
                  </button>
                  <button class="btn-delete" data-action="delete" data-type="project" data-id="${project.id}">
                    Delete
                  </button>
                </td>
              </tr>
            `
          )
          .join("");
      }

      function renderRequests() {
        if (!requests.length) {
          requestsTableBody.innerHTML = `
            <tr>
              <td colspan="7" class="empty-cell">No customer requests yet.</td>
            </tr>
          `;
          return;
        }

        requestsTableBody.innerHTML = requests
          .map((request) => {
            const currentStatus = request.status || "new";

            return `
              <tr>
                <td class="bold-cell">${escapeHTML(request.customer_name || "Customer")}</td>
                <td>${escapeHTML(request.customer_email || "")}</td>
                <td><code>${escapeHTML(request.service_code || "")}</code></td>
                <td>
                  <select class="request-status" data-id="${request.id}">
                    <option value="new" ${currentStatus === "new" ? "selected" : ""}>New</option>
                    <option value="contacted" ${currentStatus === "contacted" ? "selected" : ""}>Contacted</option>
                    <option value="in_progress" ${currentStatus === "in_progress" ? "selected" : ""}>In Progress</option>
                    <option value="completed" ${currentStatus === "completed" ? "selected" : ""}>Completed</option>
                    <option value="closed" ${currentStatus === "closed" ? "selected" : ""}>Closed</option>
                  </select>
                </td>
                <td class="request-message">${escapeHTML(request.project_details || "")}</td>
                <td>
                  <textarea class="request-notes" data-id="${request.id}">${escapeHTML(request.admin_notes || "")}</textarea>
                </td>
                <td class="actions-cell">
                  <button class="btn-primary small-btn" data-action="save-request" data-type="request" data-id="${request.id}">
                    Save
                  </button>
                  <button class="btn-delete" data-action="delete" data-type="request" data-id="${request.id}">
                    Delete
                  </button>
                </td>
              </tr>
            `;
          })
          .join("");
      }

      function clearPostForm() {
        document.getElementById("postForm").reset();
        document.getElementById("post-id").value = "";
        document.getElementById("post-action-title").textContent = "Create New Post";
        document.getElementById("post-submit-btn").textContent = "Save Post";
        document.getElementById("clear-post-btn").style.display = "none";
      }

      function clearServiceForm() {
        document.getElementById("serviceForm").reset();
        document.getElementById("service-id").value = "";
        document.getElementById("service-active").checked = true;
        document.getElementById("service-action-title").textContent = "Add Business Service";
        document.getElementById("clear-service-btn").style.display = "none";
      }

      function clearProjectForm() {
        document.getElementById("projectForm").reset();
        document.getElementById("project-id").value = "";
        document.getElementById("project-action-title").textContent = "Add Example Project";
        document.getElementById("clear-project-btn").style.display = "none";
      }

      document.getElementById("clear-post-btn").addEventListener("click", clearPostForm);
      document.getElementById("clear-service-btn").addEventListener("click", clearServiceForm);
      document.getElementById("clear-project-btn").addEventListener("click", clearProjectForm);

      document.getElementById("postForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("post-id").value;
        const title = document.getElementById("post-title").value.trim();

        const payload = {
          title,
          slug: slugify(title),
          section: document.getElementById("post-section").value,
          published: document.getElementById("post-published").value === "true",
          image_url: document.getElementById("post-image-url").value.trim() || null,
          excerpt: document.getElementById("post-excerpt").value.trim(),
          preview: document.getElementById("post-excerpt").value.trim(),
          content: document.getElementById("post-content").value.trim(),
        };

        const result = id
          ? await supabase.from("posts").update(payload).eq("id", id)
          : await supabase.from("posts").insert([payload]);

        if (result.error) {
          showStatus(result.error.message, true);
          return;
        }

        showStatus("Post saved.");
        clearPostForm();
        await loadDashboardData();
      });

      document.getElementById("contactForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("contact-id").value;

        const payload = {
          business_name: document.getElementById("business-name").value.trim(),
          business_location: document.getElementById("business-location").value.trim(),
          business_email: document.getElementById("business-email").value.trim(),
          business_phone: document.getElementById("business-phone").value.trim(),
          facebook_url: document.getElementById("facebook-url").value.trim(),
          instagram_url: document.getElementById("instagram-url").value.trim(),
          website_url: document.getElementById("website-url").value.trim(),
          updated_at: new Date().toISOString(),
        };

        const result = id
          ? await supabase.from("site_contact").update(payload).eq("id", id)
          : await supabase.from("site_contact").insert([payload]);

        if (result.error) {
          showStatus(result.error.message, true);
          return;
        }

        showStatus("Contact info saved.");
        await loadDashboardData();
      });

      document.getElementById("serviceForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("service-id").value;

        const payload = {
          title: document.getElementById("service-title").value.trim(),
          service_code: document.getElementById("service-code").value.trim(),
          short_description: document.getElementById("service-short-description").value.trim(),
          description: document.getElementById("service-description").value.trim(),
          estimate_text: document.getElementById("service-estimate").value.trim(),
          image_url: document.getElementById("service-image").value.trim() || null,
          is_active: document.getElementById("service-active").checked,
          updated_at: new Date().toISOString(),
        };

        const result = id
          ? await supabase.from("services").update(payload).eq("id", id)
          : await supabase.from("services").insert([payload]);

        if (result.error) {
          showStatus(result.error.message, true);
          return;
        }

        showStatus("Service saved.");
        clearServiceForm();
        await loadDashboardData();
      });

      document.getElementById("projectForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const id = document.getElementById("project-id").value;

        const payload = {
          title: document.getElementById("project-title").value.trim(),
          service_code: document.getElementById("project-service-code").value || null,
          category: document.getElementById("project-category").value.trim(),
          description: document.getElementById("project-description").value.trim(),
          image_url: document.getElementById("project-image").value.trim() || null,
          project_url: document.getElementById("project-url").value.trim() || null,
          is_featured: document.getElementById("project-featured").checked,
          updated_at: new Date().toISOString(),
        };

        const result = id
          ? await supabase.from("projects").update(payload).eq("id", id)
          : await supabase.from("projects").insert([payload]);

        if (result.error) {
          showStatus(result.error.message, true);
          return;
        }

        showStatus("Project saved.");
        clearProjectForm();
        await loadDashboardData();
      });

      document.addEventListener("click", async (e) => {
        const button = e.target.closest("button");
        if (!button) return;

        const action = button.dataset.action;
        const type = button.dataset.type;
        const id = button.dataset.id;

        if (!action || !type || !id) return;

        if (action === "edit" && type === "post") {
          const post = posts.find((item) => String(item.id) === String(id));
          if (!post) return;

          document.getElementById("post-id").value = post.id;
          document.getElementById("post-title").value = post.title || "";
          document.getElementById("post-section").value = post.section || "curious";
          document.getElementById("post-published").value = String(post.published);
          document.getElementById("post-image-url").value = post.image_url || "";
          document.getElementById("post-excerpt").value = post.excerpt || post.preview || "";
          document.getElementById("post-content").value = post.content || "";
          document.getElementById("post-action-title").textContent = `Editing: ${post.title}`;
          document.getElementById("post-submit-btn").textContent = "Update Post";
          document.getElementById("clear-post-btn").style.display = "inline-block";
          document.getElementById("blog-posts").scrollIntoView({ behavior: "smooth" });
          return;
        }

        if (action === "edit" && type === "service") {
          const service = services.find((item) => String(item.id) === String(id));
          if (!service) return;

          document.getElementById("service-id").value = service.id;
          document.getElementById("service-title").value = service.title || "";
          document.getElementById("service-code").value = service.service_code || "";
          document.getElementById("service-short-description").value = service.short_description || "";
          document.getElementById("service-description").value = service.description || "";
          document.getElementById("service-estimate").value = service.estimate_text || "";
          document.getElementById("service-image").value = service.image_url || "";
          document.getElementById("service-active").checked = !!service.is_active;
          document.getElementById("service-action-title").textContent = `Editing: ${service.title}`;
          document.getElementById("clear-service-btn").style.display = "inline-block";
          document.getElementById("business-services").scrollIntoView({ behavior: "smooth" });
          return;
        }

        if (action === "edit" && type === "project") {
          const project = projects.find((item) => String(item.id) === String(id));
          if (!project) return;

          document.getElementById("project-id").value = project.id;
          document.getElementById("project-title").value = project.title || "";
          document.getElementById("project-service-code").value = project.service_code || "";
          document.getElementById("project-category").value = project.category || "";
          document.getElementById("project-description").value = project.description || "";
          document.getElementById("project-image").value = project.image_url || "";
          document.getElementById("project-url").value = project.project_url || "";
          document.getElementById("project-featured").checked = !!project.is_featured;
          document.getElementById("project-action-title").textContent = `Editing: ${project.title}`;
          document.getElementById("clear-project-btn").style.display = "inline-block";
          document.getElementById("business-projects").scrollIntoView({ behavior: "smooth" });
          return;
        }

        if (action === "save-request" && type === "request") {
          const status = document.querySelector(`.request-status[data-id="${id}"]`)?.value;
          const notes = document.querySelector(`.request-notes[data-id="${id}"]`)?.value;

          const { error } = await supabase
            .from("service_requests")
            .update({
              status,
              admin_notes: notes,
            })
            .eq("id", id);

          if (error) {
            showStatus(error.message, true);
            return;
          }

          showStatus("Request updated.");
          await loadDashboardData();
          return;
        }

        if (action === "delete") {
          const confirmDelete = confirm("Delete this item?");
          if (!confirmDelete) return;

          let tableName = "";

          if (type === "post") tableName = "posts";
          if (type === "service") tableName = "services";
          if (type === "project") tableName = "projects";
          if (type === "request") tableName = "service_requests";

          if (!tableName) return;

          const { error } = await supabase.from(tableName).delete().eq("id", id);

          if (error) {
            showStatus(error.message, true);
            return;
          }

          showStatus("Item deleted.");
          await loadDashboardData();
        }
      });

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });

      document.getElementById("clear-post-btn").style.display = "none";
      document.getElementById("clear-service-btn").style.display = "none";
      document.getElementById("clear-project-btn").style.display = "none";

      const allowed = await checkAdminAccess();

      if (allowed) {
        await loadDashboardData();
      }
    </script>
  </body>
</html>

